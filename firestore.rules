rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verifiedOwner(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }

    function hasField(field) {
      return request.resource.data.keys().hasAny([field]);
    }

    function optionalString(field, maxLength) {
      return !hasField(field)
        || (request.resource.data[field] is string
          && request.resource.data[field].size() <= maxLength);
    }

    function optionalTimestamp(field) {
      return !hasField(field) || request.resource.data[field] is timestamp;
    }

    function validUserDocument() {
      return request.resource.data.keys().hasOnly([
          "displayName",
          "email",
          "photoURL",
          "alertEmailEnabled",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && optionalString("displayName", 60)
        && optionalString("photoURL", 500)
        && (!hasField("alertEmailEnabled") || request.resource.data.alertEmailEnabled is bool)
        && optionalTimestamp("createdAt")
        && optionalTimestamp("updatedAt");
    }

    function validCategory() {
      return request.resource.data.keys().hasOnly([
          "name",
          "kind",
          "color",
          "isDefault",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40
        && request.resource.data.kind in ["income", "expense", "both"]
        && request.resource.data.color is string
        && request.resource.data.color.matches("^#[0-9a-fA-F]{6}$")
        && request.resource.data.isDefault is bool
        && optionalTimestamp("createdAt")
        && optionalTimestamp("updatedAt");
    }

    function validTransaction(uid) {
      return request.resource.data.keys().hasOnly([
          "direction",
          "categoryId",
          "categoryName",
          "amount",
          "date",
          "description",
          "paymentType",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.direction in ["income", "expense"]
        && request.resource.data.categoryId is string
        && request.resource.data.categoryId.size() > 0
        && request.resource.data.categoryId.size() <= 80
        && exists(/databases/$(database)/documents/users/$(uid)/categories/$(request.resource.data.categoryId))
        && request.resource.data.categoryName is string
        && request.resource.data.categoryName.size() <= 60
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 999999999
        && request.resource.data.date is string
        && request.resource.data.date.matches("^\\d{4}-\\d{2}-\\d{2}$")
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 160
        && request.resource.data.paymentType in ["dinheiro", "pix", "debito", "credito"]
        && optionalTimestamp("createdAt")
        && optionalTimestamp("updatedAt");
    }

    match /users/{uid} {
      allow read: if verifiedOwner(uid);
      allow create, update: if verifiedOwner(uid) && validUserDocument();
      allow delete: if false;

      match /categories/{categoryId} {
        allow read: if verifiedOwner(uid);
        allow create, update: if verifiedOwner(uid) && validCategory();
        allow delete: if verifiedOwner(uid) && resource.data.isDefault != true;
      }

      match /transactions/{transactionId} {
        allow read: if verifiedOwner(uid);
        allow create, update: if verifiedOwner(uid) && validTransaction(uid);
        allow delete: if verifiedOwner(uid);
      }

      match /alerts/{alertId} {
        allow read: if verifiedOwner(uid);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
